<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net480</TargetFramework>
		<LangVersion>12.0</LangVersion>
		<ProduceReferenceAssembly>True</ProduceReferenceAssembly>
		<Platforms>x64</Platforms>
		<OutputPath>Module\bin\Win64_Shipping_Client\</OutputPath>
		<DebugType>full</DebugType>
		<!-- Set GameFolder in a local .props file or on the MSBuild command line. -->
		<GameFolder Condition="'$(GameFolder)' == ''">E:\SteamLibrary\steamapps\common\Mount &amp; Blade II Bannerlord</GameFolder>
		<!-- Build locally by default; explicit deployment copies the complete module. -->
		<DeployToGameFolder Condition="'$(DeployToGameFolder)' == ''">false</DeployToGameFolder>
		<DeployModuleFolder>$(GameFolder)\Modules\UFO</DeployModuleFolder>
		<GameBinariesFolder Condition="Exists('$(GameFolder)\bin\Win64_Shipping_Client\Bannerlord.exe')">Win64_Shipping_Client</GameBinariesFolder>
		<GameBinariesFolder Condition="Exists('$(GameFolder)\bin\Gaming.Desktop.x64_Shipping_Client\Bannerlord.exe')">Gaming.Desktop.x64_Shipping_Client</GameBinariesFolder>
		<WorkshopRoot Condition="'$(WorkshopRoot)' == ''">$([System.IO.Path]::GetFullPath('$(GameFolder)\..\..\workshop\content\261550'))</WorkshopRoot>
		<HarmonyAssemblyPath Condition="'$(HarmonyAssemblyPath)' == ''">$(WorkshopRoot)\2859188632\bin\$(GameBinariesFolder)\0Harmony.dll</HarmonyAssemblyPath>
		<ButterLibAssemblyPath Condition="'$(ButterLibAssemblyPath)' == ''">$(WorkshopRoot)\2859232415\bin\$(GameBinariesFolder)\Bannerlord.ButterLib.dll</ButterLibAssemblyPath>
		<UIExtenderExAssemblyPath Condition="'$(UIExtenderExAssemblyPath)' == ''">$(WorkshopRoot)\2859222409\bin\$(GameBinariesFolder)\Bannerlord.UIExtenderEx.dll</UIExtenderExAssemblyPath>
		<McmAssemblyPath Condition="'$(McmAssemblyPath)' == ''">$(WorkshopRoot)\2859238197\bin\$(GameBinariesFolder)\MCMv5.dll</McmAssemblyPath>
		<PlatformTarget>x64</PlatformTarget>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
		<OutputPath>bin\Debug\</OutputPath>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="$(GameFolder)\bin\$(GameBinariesFolder)\Newtonsoft.Json.dll">
			<HintPath>%(Identity)</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="$(GameFolder)\bin\$(GameBinariesFolder)\TaleWorlds.*.dll" Exclude="$(GameFolder)\bin\$(GameBinariesFolder)\TaleWorlds.Native.dll">
			<HintPath>%(Identity)</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="$(GameFolder)\Modules\Native\bin\$(GameBinariesFolder)\*.dll">
			<HintPath>%(Identity)</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="$(GameFolder)\Modules\SandBox\bin\$(GameBinariesFolder)\*.dll">
			<HintPath>%(Identity)</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="$(GameFolder)\Modules\SandBoxCore\bin\$(GameBinariesFolder)\*.dll">
			<HintPath>%(Identity)</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="$(GameFolder)\Modules\StoryMode\bin\$(GameBinariesFolder)\*.dll">
			<HintPath>%(Identity)</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="$(GameFolder)\Modules\CustomBattle\bin\$(GameBinariesFolder)\*.dll">
			<HintPath>%(Identity)</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="$(GameFolder)\Modules\BirthAndDeath\bin\$(GameBinariesFolder)\*.dll">
			<HintPath>%(Identity)</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="$(GameFolder)\Modules\NavalDLC\bin\$(GameBinariesFolder)\*.dll">
			<HintPath>%(Identity)</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<!-- Compile against the exact dependencies loaded by the installed game. -->
		<Reference Include="$(HarmonyAssemblyPath);$(ButterLibAssemblyPath);$(UIExtenderExAssemblyPath);$(McmAssemblyPath)">
			<HintPath>%(Identity)</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<!-- Standalone compatibility tooling is not part of the game module. -->
		<Compile Remove="Tools\**\*.cs" />
		<None Include="Module\bin\Win64_Shipping_Client\*" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove="Module\bin\Win64_Shipping_Client\UFO.dll" />
	  <None Remove="Module\bin\Win64_Shipping_Client\UFO.pdb" />
	</ItemGroup>

	<Target Name="CopyOutputToModFolder" AfterTargets="Build" Condition="'$(DeployToGameFolder)' == 'true'">
		<ItemGroup>
			<FilesToCopy Include="Module\**\*.*" />
		</ItemGroup>

		<Copy SourceFiles="@(FilesToCopy)" DestinationFiles="@(FilesToCopy->'$(DeployModuleFolder)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
	</Target>
	<Target Name="ValidateInstalledDependencies" BeforeTargets="ResolveReferences">
		<Error Condition="!Exists('$(HarmonyAssemblyPath)')" Text="Set HarmonyAssemblyPath to the installed 0Harmony.dll." />
		<Error Condition="!Exists('$(ButterLibAssemblyPath)')" Text="Set ButterLibAssemblyPath to the installed Bannerlord.ButterLib.dll." />
		<Error Condition="!Exists('$(UIExtenderExAssemblyPath)')" Text="Set UIExtenderExAssemblyPath to the installed Bannerlord.UIExtenderEx.dll." />
		<Error Condition="!Exists('$(McmAssemblyPath)')" Text="Set McmAssemblyPath to the installed MCMv5.dll." />
	</Target>

</Project>
